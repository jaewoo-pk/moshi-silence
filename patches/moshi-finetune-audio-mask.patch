+            continue
+        f0 = max(0, math.floor((start - pre_sec) * frame_rate))
+        f1 = min(num_frames, math.ceil((end + post_sec) * frame_rate))
+        if f1 > f0:
+            keep[0, f0:f1] = False
+    return keep
 
 
