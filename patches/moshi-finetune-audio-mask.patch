+def main_speech_keep_mask(
+    alignments: list[Alignment],
+    num_frames: int,
+    frame_rate: float,
+    main_speaker: str,
+    pre_sec: float,
+    post_sec: float,
+) -> torch.Tensor:
+    """[1, num_frames] bool: False on every frame that overlaps a main-speaker word,
+    widened by pre_sec before and post_sec after (onset transient, decay, and Mimi's
+    causal frames still carrying the tail). Times are audio times, so no text delay."""
+    keep = torch.ones(1, num_frames, dtype=torch.bool)
+    for _, (start, end), speaker in alignments:
