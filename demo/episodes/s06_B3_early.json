ait, there are just two. What do you think?"}, {"spk": "user", "t": [29.297, 30.957], "text": "She does use her pencils every day."}]}, "meta": {"id": "s06_B3_early", "type": "B3_early", "split": "train", "pack": "b3_d1f6c3e0", "voices": {"moshi": "michael", "user": "alba", "friend": "eponine"}, "params": {"friend_gain_db": -8.0, "friend_rt60": 0.2, "noise": "white_lp", "snr_db": 23.0, "ack": true, "k": 3, "n_presented": 2, "distractors": [], "release": {"kind": "cue"}}, "templates": {"instr": "train:10", "cue": "train:1"}, "clips": ["e1f10fcdf5867a52", "0f7203dca4b2d160", "9954cc4e11eb3d40", "ef15006e5c745ac0", "3efce1ebe82301f8", "b9094b64607b3bd2", "b996e9736fcc2fcb", "4948075ff457be9a", "435c089742a565ea", "2f65d4395bf3a281"]}}